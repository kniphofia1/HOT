# Copy this file to .env for local development.
# Do not commit real secrets.

APP_ENV=development

# Database
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
DATABASE_URL=postgresql://radar:radar@db:5432/radar

# AI provider used for clustering and summaries.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# Optional GitHub token for higher API limits.
GITHUB_TOKEN=

# Local service ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
