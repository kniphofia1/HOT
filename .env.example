# Copy this file to .env for local development.
# Do not commit real secrets.

APP_ENV=development

# Database
DATABASE_URL=postgresql://radar:radar@localhost:5432/radar

# AI provider used for clustering and summaries.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Optional GitHub token for higher API limits.
GITHUB_TOKEN=

# Local service ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
