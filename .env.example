# Copy this file to .env for local development.
# Do not commit real secrets.

APP_ENV=development
ENABLE_AUTOMATION_SCHEDULER=true

# Database used by Docker Compose.
# For local SQLite development, use scripts/dev-sqlite.ps1 instead of this DATABASE_URL.
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
DATABASE_URL=postgresql://radar:radar@db:5432/radar

# AI provider used for clustering and summaries.
# DeepSeek OpenAI-compatible API. Fill AI_API_KEY in your local .env only.
AI_PROVIDER=openai_compatible
AI_MODEL=deepseek-v4-flash
AI_FAST_MODEL=deepseek-v4-flash
AI_HIGH_MODEL=deepseek-v4-pro
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com

# Optional GitHub token for higher API limits.
GITHUB_TOKEN=

# Optional Reddit credentials for higher API reliability.
# Leave blank to use public JSON endpoints.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hot-radar/0.1

# Optional official or authorized platform credentials.
# These are only read from environment variables and must never be committed with real values.
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
LINKEDIN_ACCESS_TOKEN=
TIKTOK_RESEARCH_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=

# Local service ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend server-side API base URL.
API_BASE_URL=http://backend:8000

# Production VPS deployment.
# SITE_DOMAIN must be a bare domain name, for example radar.example.com.
SITE_DOMAIN=radar.example.com
BASIC_AUTH_USER=admin
# Generate with:
# docker run --rm caddy:2-alpine caddy hash-password --plaintext "replace-with-a-strong-password"
# Keep the generated hash wrapped in single quotes in .env.production because bcrypt hashes contain $.
BASIC_AUTH_HASH=
